# ========================================================
# Ingress Within — Production Environment Configuration
# ========================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# JWT Session Authentication
JWT_SECRET=generate_a_secure_64_character_hex_string

# Journal Entry Encryption (AES-256-GCM, 32-byte key as 64-char hex string)
ENCRYPTION_MASTER_KEY=generate_a_64_character_hex_string_here

# MSG91 Phone OTP Authentication
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id
MSG91_SENDER_ID=INGWRT

# AI Providers (Claude Primary + Groq Failover + Gemini Knowledge Engine)
AI_PROVIDER=claude
CLAUDE_API_KEY=your_anthropic_claude_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Background Processing & Scheduling
BYPASS_REDIS=true
CRON_SECRET=generate_a_secure_cron_secret_here

# ========================================================
# Transactional Email System (Resend + BullMQ / In-Process)
# ========================================================
# Resend API Key (Required in Production: starts with 're_')
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Resend Sender / From Address (Must be on a domain verified in Resend Dashboard)
EMAIL_FROM=no-reply@ingresswithin.com
EMAIL_FROM_NAME=Ingress Within

# Support / Reply-To Address
EMAIL_REPLY_TO=contactus@ingresswithin.com

# Authoritative notification email recipients
THERAPIST_APPLICATION_NOTIFICATION_EMAIL=contactus@ingresswithin.com
OPS_TEAM_EMAIL=contactus@ingresswithin.com

# Resend Webhook Secret (starts with 'whsec_' from Resend Dashboard -> Webhooks)
# Used to verify incoming delivery, bounce, and complaint webhooks at /api/webhooks/email
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Email Dispatch Mode: "queue" | "immediate"
# Set to "immediate" for Vercel/Serverless deployment or when running without a persistent Redis worker daemon.
# Set to "queue" when running with BullMQ and persistent worker daemon ('npm run worker').
EMAIL_DISPATCH_MODE=immediate

# Development / Mock override: strictly for offline local test environments without live Resend credentials.
# In production, this must remain false or unset so missing credentials fail explicitly.
ALLOW_MOCK_EMAIL=false


# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_ID=plan_your_plan_id

# Google Calendar & Meet Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://ingresswithin.com/api/calendar/google/callback
