# ========================================================
# Ingress Within — Production Environment Configuration
# ========================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# JWT Session Authentication
JWT_SECRET=generate_a_secure_64_character_hex_string

# Journal Entry Encryption (AES-256-GCM, 32-byte key as 64-char hex string)
ENCRYPTION_MASTER_KEY=generate_a_64_character_hex_string_here

# MSG91 Phone OTP Authentication
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id
MSG91_SENDER_ID=INGWRT

# AI Providers (Claude Primary + Groq Failover + Gemini Knowledge Engine)
AI_PROVIDER=claude
CLAUDE_API_KEY=your_anthropic_claude_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Background Processing & Scheduling
BYPASS_REDIS=true
CRON_SECRET=generate_a_secure_cron_secret_here

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_ID=plan_your_plan_id

# Google Calendar & Meet Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.ingresswithin.com/api/calendar/google/callback
